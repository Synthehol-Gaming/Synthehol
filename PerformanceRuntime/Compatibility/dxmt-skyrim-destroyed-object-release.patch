 struct D3D11ResourceCommon : ID3D11Resource {
+  /* ComObject overrides these. They only run on a destroyed resource, whose vtable is this
+   * one again: Skyrim SE releases a texture once more than it holds, which Windows (and
+   * DXVK) silently tolerate, while a pure virtual here would abort. */
+  ULONG STDMETHODCALLTYPE AddRef() override { return 0; }
+  ULONG STDMETHODCALLTYPE Release() override { return 0; }
+
     /* ID3D11Buffer::GetDesc */
     /* ID3D11Texture1D::GetDesc */
     /* ID3D11Texture2D::GetDesc */
